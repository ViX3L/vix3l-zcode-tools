{
  "name": "vix3l-zcode-tools",
  "private": true,
  "version": "0.0.0",
  "description": "Test harness for the ViX3L ZCode Tools plugin marketplace. The plugins themselves are plain Node ESM with no runtime dependencies; everything here is test-only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=60000 \"tests/**/*.test.mjs\"",
    "test:unit": "node --test --test-timeout=60000 \"tests/unit/**/*.test.mjs\"",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=60000 \"tests/integration/**/*.test.mjs\"",
    "test:ui": "node --test --test-concurrency=1 --test-timeout=60000 \"tests/ui/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=60000 \"tests/e2e/**/*.test.mjs\"",
    "test:docker": "docker compose -f tests/docker/compose.yml run --rm tests",
    "test:docker:build": "docker compose -f tests/docker/compose.yml build",
    "test:browser:install": "playwright install chromium",
    "quality": "npm run quality:sync && npm run quality:dupes && npm run quality:dead && npm run quality:lint",
    "quality:sync": "node scripts/sync-shared.mjs --check",
    "quality:dupes": "node scripts/quality/dupes.mjs",
    "quality:dead": "node scripts/quality/dead.mjs",
    "quality:lint": "node scripts/quality/lint.mjs",
    "quality:score": "node scripts/quality/score.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
