[Desktop Entry]
# Installed path placeholder: replace the Exec path below with the absolute path
# to zcode-stats.sh in your plugin checkout (a .desktop file cannot discover its
# own directory). See docs/cross-platform.md.
# Copy this file to ~/.local/share/applications/ after editing.
Name=ZCode (with stats)
Comment=Start ZCode with a local CDP port so the stats-composer composer pill can attach
Exec=/opt/ZCode/stats-composer/zcode-stats.sh %U
Terminal=false
Type=Application
Icon=zcode
StartupWMClass=ZCode
MimeType=x-scheme-handler/zcode;
Categories=Development;
