{
  "description": "usage-context: per-turn usage chips in the assistant turn footer",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeoutMs": 6000,
            "statusMessage": "usage-context: init"
          }
        ]
      }
    ]
  }
}
